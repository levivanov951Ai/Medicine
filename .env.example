# Пример переменных окружения. Скопируйте в .env.local и заполните.
# Настоящие значения в репозиторий не коммитятся (.gitignore: .env*).

# --- Источник данных -------------------------------------------------------
# mock — демонстрационные данные (по умолчанию, разработка и демо).
# crm  — настоящая CRM. Пока CRM-реализаций нет, сборка с crm остановится
#        с понятной ошибкой (src/services/config.ts, docs/CRM_INTEGRATION.md).
# Не секрет: значение попадает и в браузерный код (next.config.ts).
DATA_SOURCE=mock

# --- Окружение сайта (индексация, canonical-адрес) --------------------------
# staging (по умолчанию) — поисковики не индексируют сайт (robots.txt,
# meta robots и заголовок X-Robots-Tag). production — индексация разрешена
# для публичных страниц; кабинет, запись и вход остаются noindex всегда.
# См. src/lib/site-config.ts.
NEXT_PUBLIC_SITE_ENV=staging

# Канонический адрес сайта — для metadataBase и sitemap.xml. Пока домен не
# назначен (UNKNOWN), оставьте пустым: сайт работает и без него, просто
# sitemap.xml будет пустым и OG/canonical-ссылки не строятся.
NEXT_PUBLIC_SITE_URL=

# --- Демонстрационный режим (PROJECT_CONTEXT.md, PD-26) ---------------------
# true — на шаге подтверждения номера показывается «Демо-код: 11111».
# По умолчанию выключен. Временная функция: удалить при подключении реальной авторизации.
NEXT_PUBLIC_DEMO_MODE=false

# --- CRM (только сервер) ----------------------------------------------------
# Заготовка. Точные названия и состав переменных определяются документацией CRM
# (способ аутентификации — UNKNOWN). Секреты CRM НИКОГДА не называются NEXT_PUBLIC_*
# и используются только в серверном коде Next.js.
# CRM_BASE_URL=
# CRM_API_KEY=
